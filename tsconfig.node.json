{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/host/**/*.ts",
    "src/shared/**/*.ts",
    // The git, checkpoint and workspace engines are pure Node (no Electron, no
    // DOM), so they are checked by the node project and can run in main and under
    // the bundled host runtime.
    "src/git/**/*.ts",
    "src/checkpoints/**/*.ts",
    "src/workspace/**/*.ts",
    "src/extensions/**/*.ts",
    // The completion engine is pure (no DOM, no React): the node project checks it
    // and `tests/completion/**` runs it without a DOM (plan step 7). The overlay
    // (.tsx) stays in the renderer project.
    "src/renderer/src/completion/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vite.host.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "tests/renderer/**",
    "tests/e2e/**",
    "tests/screenshots/**",
    "src/renderer/src/completion/**/*.tsx"
  ]
}
