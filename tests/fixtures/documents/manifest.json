    {
      "id": "malformed-container",
      "format": "odt",
      "class": "hostile",
      "covers": "malformed central directory",
      "expected": "failure",
      "failure": "malformed_document"
    },
    {
      "id": "unsupported-format",
      "format": "docx",
      "class": "hostile",
      "covers": "legacy .doc or encrypted package declared as docx",
      "expected": "failure",
      "failure": "unsupported_format"
