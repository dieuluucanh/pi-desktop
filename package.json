{
  "name": "pi-desktop",
  "desktopName": "pi-desktop.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Desktop — a standalone desktop app for the Pi coding agent (with zero-touch Pi for Office)",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Pi Desktop contributors",
    "email": "dieuluucanh@gmail.com"
  },
  "homepage": "https://github.com/dieuluucanh/pi-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/dieuluucanh/pi-desktop.git"
  },
  "main": "out/main/index.mjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:host && node scripts/dev.mjs",
    "dev:host": "vite build --watch --config vite.host.config.ts",
    "dev:electron": "electron-vite dev --watch",
    "build": "npm run build:host && electron-vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:perf": "playwright test --grep @perf",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "runtime:lock": "node scripts/fetch-runtime.mjs --update-lock",
    "runtime:shims": "node scripts/gen-shims.mjs",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "icons:gen": "node scripts/gen-icons.mjs",
    "doctor": "vitest run tests/runtime/doctor.live.test.ts --disable-console-intercept",
    "package:win": "npm run runtime:fetch && npm run build && npm run runtime:verify && electron-builder --win --publish never",
    "package:mac": "npm run runtime:fetch -- --all && npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run runtime:fetch -- --all && npm run build && electron-builder --linux --publish never",
    "office:doctor": "vitest run tests/office/detect.live.test.ts --disable-console-intercept",
    "office:manifest:check": "node scripts/sync-office-manifest.mjs --check",
    "office:manifest:sync": "node scripts/sync-office-manifest.mjs --source ../pi-for-office/packages/add-in/manifest.prod.xml"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "get-east-asian-width": "1.6.0",
    "lucide-react": "1.47.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "semver": "^7.8.5",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "typebox": "1.3.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "png-to-ico": "^3.0.2",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
