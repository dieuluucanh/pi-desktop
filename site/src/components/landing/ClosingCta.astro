---
import { withBase } from "../../../site.config.mjs";
import DownloadCta from "./DownloadCta.astro";

interface Props {
  version: string;
}

const { version } = Astro.props;
---

<section class="pi-closing" aria-labelledby="pi-closing-title">
  <div>
    <p class="pi-kicker">Ready when you are</p>
    <h2 id="pi-closing-title">Give the agent a proper window.</h2>
    <p>
      Download the current build, open a project, and keep using the same Pi profile you already
      have.
    </p>
  </div>
  <div class="pi-actions">
    <DownloadCta version={version} label="Download Pi Desktop" />
    <a class="pi-button pi-button--secondary" href={withBase("/docs/")}>
      Browse the docs
    </a>
    <a
      class="pi-button pi-button--secondary"
      href="https://github.com/dieuluucanh/pi-desktop"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
  </div>
</section>
