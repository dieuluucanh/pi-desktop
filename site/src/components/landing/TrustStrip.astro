---
const items = [
  { label: "Same profile as terminal Pi", detail: "~/.pi/agent" },
  { label: "Bundled Node 24", detail: "No system install" },
  { label: "MIT licensed", detail: "Open source" },
  { label: "Telemetry off by default", detail: "Opt-in only" },
];
---

<section class="pi-trust" aria-label="Pi Desktop at a glance">
  {items.map((item) => (
    <div class="pi-trust__item">
      <strong>{item.label}</strong>
      <span>{item.detail}</span>
    </div>
  ))}
</section>

<style>
  .pi-trust {
    border-block: 1px solid var(--sl-color-hairline, #d8d2c2);
    column-gap: 0.75rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 2rem 0;
    padding: 1rem 0;
    row-gap: 0.15rem;
  }
  .pi-trust__item {
    display: grid;
    /* Subgrid keeps the label row and detail row aligned across items, even
       when "Same profile as terminal Pi" wraps to two lines. The row rhythm
       comes from .pi-trust's row-gap, so the item must not set its own gap. */
    grid-row: span 2;
    grid-template-rows: subgrid;
  }
  .pi-trust__item strong {
    color: var(--pi-text);
    font-size: var(--sl-text-sm, 0.875rem);
  }
  .pi-trust__item span {
    color: var(--pi-text-muted);
    font-size: var(--sl-text-xs, 0.75rem);
  }
  @media (max-width: 42rem) {
    .pi-trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0.75rem;
    }
  }
</style>
