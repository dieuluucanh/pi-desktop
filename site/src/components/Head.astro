---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { absoluteUrl, withBase } from "../../site.config.mjs";
import manifest from "../data/site.generated.json";

const isLanding = Astro.url.pathname === withBase("/");
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Pi Desktop",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  softwareVersion: manifest.version,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://github.com/dieuluucanh/pi-desktop/blob/main/LICENSE",
  downloadUrl: "https://github.com/dieuluucanh/pi-desktop/releases/latest",
  sameAs: ["https://github.com/dieuluucanh/pi-desktop"],
};
---

<DefaultHead />
<meta name="pi-desktop-release" content={manifest.version} />
{/*
  Choose the detected platform before first paint so the card grids can order
  and highlight it without a layout shift. The arch-aware detection lives in
  src/lib/downloads.ts; this only needs the OS family.
*/}
<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    document.documentElement.dataset.detectedOs = /Windows/i.test(ua)
      ? "windows"
      : /Macintosh|Mac OS X/i.test(ua)
        ? "macos"
        : /Linux|X11/i.test(ua)
          ? "linux"
          : "";
  })();
</script>
<meta property="og:image" content={absoluteUrl("/og.png")} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Pi Desktop — the Pi coding agent, without the terminal" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={absoluteUrl("/og.png")} />
<meta name="theme-color" content="#0A3D9C" />
<link rel="apple-touch-icon" href={withBase("/brand/icon-256.png")} />
{isLanding && <script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />}
