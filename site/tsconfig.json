{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node", "astro/client"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["tests", "dist", "node_modules", ".astro"]
}
