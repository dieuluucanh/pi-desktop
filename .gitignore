node_modules/
dist/
out/
release/
coverage/
packages/checkpoints/index.mjs
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Bundled Node/npm runtime and generated PATH shims are fetched, never committed.
# The lockfile is the exception: it pins the version and checksums.
resources/runtime/*
!resources/runtime/README.md
!resources/runtime/node.lock.json

# The staged Workflow bundle is generated from a pinned tarball
# (`npm run workflow:stage`) and must never be committed. The lockfile and the
# directory README are the tracked facts.
resources/extensions/*
!resources/extensions/README.md
resources/workflow/*.tgz

# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/
.pi/plans

# Public site (site/ owns its dependencies and generated content)
site/node_modules/
site/dist/
site/.astro/
site/src/content/docs/guide/
site/src/content/docs/architecture/
site/src/content/docs/product/
site/src/content/docs/releases/
site/src/content/docs/docs/
site/src/data/site.generated.json
site/src/assets/brand/
site/public/brand/
site/public/docs/
site/public/favicon.svg
site/test-results/
# Machine-local Pi project settings (absolute policy grants); the tracked
# template is .pi/settings.example.json.
.pi/settings.json
